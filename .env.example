# Copy to .env and fill all four values. Use single quotes for literal $ characters.
# These values are passed only when starting the container, never during its build.
ONEBOT_ACCESS_TOKEN=
ONEBOT_SECRET=
DEEPSEEK_API_KEY=
ASSISTANTBOT_ADMIN_TOKEN=

# Optional: a different host config file and the maximum number of build jobs.
# ASSISTANTBOT_CONFIG=./config.json
# BUILD_JOBS=2

# Add environment variables named by optional model roles or MCP services here.
# VISION_API_KEY=
